APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# MySQL database dedicated to IT Platform (development and production).
# Replace host and credentials. URL-encode special characters in credentials.
DATABASE_URL=mysql+pymysql://it_platform_app:CAMBIAR_PASSWORD@127.0.0.1:3306/it_platform?charset=utf8mb4
COOKIE_SECURE=false
# Separate SELECT-only account. Do not use the Employees application's credentials.
RH_DATABASE_URL=
RH_TABLE=employee_ki
RH_ID_COLUMN=Employee_No
# Confirm actual column names before enabling the connector.
RH_NAME_COLUMNS=Employee_Name,Last_Name,Middle_Name
RH_DEPARTMENT_COLUMN=Department_Code

# Separate encryption key file. Never put its contents in DATABASE_URL or git.
VAULT_KEY_FILE=
